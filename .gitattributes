# Default : LF partout, auto-detection texte
* text=auto eol=lf

# Scripts Windows : CRLF obligatoire
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Code source
*.rs    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# Binaires
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.icns  binary
*.pdf   binary
*.zip   binary
*.msi   binary
*.exe   binary
*.dll   binary
*.db    binary
