{
  "name": "synk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "format": "prettier --check src scripts \"*.config.{ts,js,mjs}\" \"tsconfig*.json\" components.json",
    "format:fix": "prettier --write src scripts \"*.config.{ts,js,mjs}\" \"tsconfig*.json\" components.json",
    "plate:check": "node scripts/plate-check.mjs",
    "icons:gen": "node scripts/build-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "check": "node scripts/verify.mjs --rapide",
    "verify": "node scripts/verify.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "bump": "node scripts/bump-version.mjs",
    "release": "node scripts/release.mjs",
    "veille": "node scripts/veille.mjs",
    "doc:commandes": "node scripts/commandes-doc.mjs",
    "budget": "node scripts/bundle-budget.mjs",
    "taille": "node scripts/taille-fichiers.mjs",
    "couverture:rust": "node scripts/couverture-rust.mjs",
    "parcours": "node scripts/parcours.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json"
  },
  "dependencies": {
    "@radix-ui/react-focus-scope": "^1.1.8",
    "@tanstack/react-query": "^5.95.2",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.3",
    "@tauri-apps/plugin-opener": "~2.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.61.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "~19.2.4",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "~2.11.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "axe-core": "~4.11.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "react-is": "$react-is",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
